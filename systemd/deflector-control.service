[Unit]
Description=Deflector Control lighting controller
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/deflector-control
Environment=NODE_ENV=production
Environment=PORT=80
Environment=HOST=0.0.0.0
Environment=DMX_OUTPUT=dry-run
Environment=OLA_URL=http://localhost:9090
ExecStart=/home/pi/deflector-control/scripts/start-pi.sh
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
